# =============================================================================
# HQ API — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# CORE
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
DATABASE_URL=
CLOUD_SQL_CONNECTION_NAME=

# ---------------------------------------------------------------------------
# AUTH
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# EMAIL (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# AI PROVIDER CHAIN
#
# Production priority order:
#   1. Vertex AI  (gemini-2.5-flash → 2.5-pro) — PRIMARY  [Cloud Run IAM, no API key]
#   2. Gemini     (gemini-2.5-flash)             — FAILOVER 1
#   3. OpenAI     (gpt-4o)                        — FAILOVER 2
#   4. Anthropic  (claude-3-5-sonnet)             — FAILOVER 3
#   5. Graceful degradation notice               — LAST RESORT
#
# ---------------------------------------------------------------------------

# Primary provider: vertex | gemini | openai | anthropic
AI_PROVIDER=vertex

# Enable automatic failover when the primary provider fails
# Recommended: true in production, false only for isolated testing
AI_FAILOVER_ENABLED=true

# Ordered comma-separated failover list (left = tried first)
# Only providers with valid credentials will be activated in the chain
AI_FAILOVER_PROVIDERS=gemini,openai,anthropic

# ---------------------------------------------------------------------------
# VERTEX AI — Primary (Production)
# Authentication: Cloud Run IAM ADC — no API key needed on Cloud Run.
# For local dev: set GOOGLE_APPLICATION_CREDENTIALS to a service account JSON.
# ---------------------------------------------------------------------------
VERTEX_PROJECT_ID=
VERTEX_LOCATION=europe-west1
VERTEX_MODEL=gemini-2.5-flash
VERTEX_FALLBACK_MODEL=gemini-2.5-pro

# GCP project (used by Vertex and Cloud SQL)
GOOGLE_CLOUD_PROJECT=
# For local dev only — path to GCP service account JSON key
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---------------------------------------------------------------------------
# GEMINI DIRECT — Failover 1 / Local Development Primary
# Get key: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-pro

# ---------------------------------------------------------------------------
# OPENAI — Failover 2
# Get key: https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# ANTHROPIC — Failover 3
# Get key: https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---------------------------------------------------------------------------
# STRIPE (Billing)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# WEB RESEARCH (Serper / SerpAPI)
# ---------------------------------------------------------------------------
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# CIRCLE (Crypto Wallet / Payments)
# ---------------------------------------------------------------------------
CIRCLE_API_KEY=
CIRCLE_WALLET_SET_ID=